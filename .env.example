# Assistants (JWT + id) are NOT configured here: add them in Harness → Настройки → Ассистенты.
# They are stored in assistants.json next to the proxy.
# Optional overrides
AIST_BASE_URL=https://agent.aist-ai.com
# Local port for the Anthropic-compatible endpoint
PORT=3091
# Any value; the harness sends it as x-api-key and we accept any non-empty value
PROXY_API_KEY=local
# Polling interval in ms
POLL_INTERVAL_MS=1000
# Max seconds to wait for one AiST step before reporting an error
STEP_TIMEOUT_S=1800
# Anthropic-compatible vision endpoint used to describe images inside tool results
VISION_API_URL=https://jetstream.aist-ai.com/_claude/v1/messages
VISION_API_KEY=
VISION_MODEL=claude-sonnet-4-5-20250929
