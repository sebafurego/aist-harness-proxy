# JWT for agent.aist-ai.com (RS256, ability agent-api)
AIST_TOKEN=
# Assistant id used for every task
AIST_ASSISTANT_ID=87
# Optional overrides
AIST_BASE_URL=https://agent.aist-ai.com
# Local port for the Anthropic-compatible endpoint
PORT=3091
# Any value; the harness sends it as x-api-key and we accept any non-empty value
PROXY_API_KEY=local
# Polling interval in ms
POLL_INTERVAL_MS=1000
# Max seconds to wait for one AiST step before reporting an error
STEP_TIMEOUT_S=1800
